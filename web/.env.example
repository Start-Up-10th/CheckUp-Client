# Public env vars only (NEXT_PUBLIC_*). Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=

# Server-only. Next가 /api/* 요청을 넘길 Spring 서버 주소 (next.config.mjs rewrites). 비우면 http://localhost:8080
API_PROXY_TARGET=

# DataGSM OAuth (REQ-AUTH-001)
NEXT_PUBLIC_DATAGSM_AUTH_URL=https://oauth.authorization.datagsm.kr/v1/oauth/authorize
NEXT_PUBLIC_DATAGSM_CLIENT_ID=
NEXT_PUBLIC_AUTH_REDIRECT_URI=
